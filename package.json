{
  "name": "@semabit/cordova-icon",
  "version": "1.6.0",
  "description": "Automatic icon resizing for Cordova",
  "main": "index.js",
  "preferGlobal": true,
  "bin": "bin/cordova-icon",
  "directories": {
    "bin": "./bin"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "./bin/build",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/semabit/cordova-icon.git"
  },
  "keywords": [
    "cordova",
    "icon",
    "resize"
  ],
  "author": "Alex Disler",
  "license": "MIT",
  "homepage": "https://github.com/semabit/cordova-icon",
  "dependencies": {
    "colors": "^1.4.0",
    "fs-extra": "^11.3.4",
    "imagemagick": "^0.1.3",
    "minimist": "^1.2.0",
    "q": "^1.0.1",
    "underscore": "^1.6.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "release-it": "^20.0.1"
  },
  "release-it": {
    "hooks": {
      "after:npm:bump": "yarn build"
    },
    "git": {
      "tagName": "v${version}",
      "tagArgs": "-s"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "tokenRef": "GITHUB_TOKEN_CLI_RELEASER"
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishPath": "dist"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@4.12.0"
}
